{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-git.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-rs.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".claude/hooks/clippy-rs.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-cargo.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
